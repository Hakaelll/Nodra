NODE_ENV=development
DATABASE_URL=postgresql://nodra:nodra_local@localhost:5432/nodra
TEST_DATABASE_URL=postgresql://nodra:nodra_local@localhost:5433/nodra_test
JWT_SECRET=development-only-replace-with-random-64-characters-before-production
PORT=4000
# Opt-in LAN access for a physical Android debug device: API_BIND_HOST=0.0.0.0
API_BIND_HOST=127.0.0.1
# Worker health listens only on loopback; 0 allocates an ephemeral test port.
WORKER_HEALTH_PORT=4100
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
# Optional development browser host for a device on your private LAN.
# NODRA_LAN_HOST=192.168.1.133
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
# Optional isolated queue for integration tests; default is nodra-notifications.
# NOTIFICATION_QUEUE_NAME=nodra-notifications
MAIL_PROVIDER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Nodra <noreply@nodra.local>
PUSH_PROVIDER=console
FCM_ENABLED=false
STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_ROOT=.local
# Optional: set STORAGE_PROVIDER=s3 and uncomment all values to use local MinIO.
# Never use these development credentials in production.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=nodra_local
# S3_SECRET_KEY=nodra_local_storage_only
# S3_BUCKET=nodra
# Reserved for future instrumentation; no telemetry module currently reads it.
# OTEL_ENABLED=false
